# Normalize line endings: LF in repo, native on checkout
* text=auto eol=lf

# Force LF for shell scripts and Python (deploy target is Linux)
*.sh    text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.ico   binary
