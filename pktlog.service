# Template — install.sh substitutes __INSTALL_DIR__ / __LOG_DIR__ /
# __SERVICE_USER__ / __SERVICE_GROUP__ before installing to systemd.
# For a manual install, replace these placeholders yourself.
[Unit]
Description=pktLog Syslog Management Platform
Documentation=https://github.com/bsnwgit/pktlog
After=network.target
# Uncomment if ClickHouse runs on this host and is managed by systemd:
# Requires=clickhouse-server.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__

# Config — PKTLOG_INSTALL_DIR is the app root; every on-disk path (db, logs,
# ingest journal, ssl certs, backups) defaults to somewhere under it unless
# overridden in config.yaml. See app/config.py.
Environment=PKTLOG_CONFIG=__INSTALL_DIR__/config.yaml
Environment=PKTLOG_INSTALL_DIR=__INSTALL_DIR__

# Launch via start.sh, which auto-detects an uploaded SSL cert
# (ssl/server.crt + server.key) and adds --ssl-certfile/--ssl-keyfile.
# Plain HTTP by default; upload a cert via Settings → SSL/TLS and restart
# to switch to HTTPS — no other config needed.
ExecStart=__INSTALL_DIR__/start.sh

# `always` (not `on-failure`) so the app's own restart-service fallback
# (sending SIGTERM to the master process when it lacks passwordless sudo to
# run `systemctl restart` directly — see app/api/system.py _delayed_restart)
# actually causes systemd to bring the service back up. A clean SIGTERM is
# not "failure" from systemd's point of view, so on-failure never restarts
# it — the service just stops and stays down. `systemctl stop`/`restart`
# still work normally either way, since those go through systemd's own
# stop sequence, which isn't affected by the Restart= policy.
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Logging
StandardOutput=append:__LOG_DIR__/pktlog.log
StandardError=append:__LOG_DIR__/pktlog.log

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
