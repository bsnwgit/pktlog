[Unit]
Description=pktLog Syslog Management Platform
Documentation=https://github.com/<org_name>/pktlog
After=network.target
# Uncomment if using ClickHouse backend:
# Requires=clickhouse-server.service

[Service]
Type=simple
User=<DEPLOY_USER>
Group=<DEPLOY_USER>
WorkingDirectory=<INSTALL_DIR>

# Config
Environment=PKTLOG_CONFIG=<INSTALL_DIR>/config.yaml

# Launch FastAPI via Uvicorn
# --workers 2 is safe for a single EC2; increase if CPU allows
ExecStart=<INSTALL_DIR>/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8768 \
    --workers 2 \
    --log-level info \
    --no-access-log

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Logging
StandardOutput=append:/mnt/software/logs/pktlog.log
StandardError=append:/mnt/software/logs/pktlog.log

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target